{
  "name": "courtto-academy",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:server": "vitest run --project server",
    "test:e2e": "playwright test",
    "auth:generate": "auth generate --config server/utils/auth.ts --output server/database/schema.ts -y && eslint server/database/schema.ts --fix"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1081.0",
    "@iconify-json/lucide": "^1.2.114",
    "@iconify-json/simple-icons": "^1.2.86",
    "@internationalized/date": "^3.12.2",
    "@nuxt/ui": "^4.9.0",
    "@nuxtjs/i18n": "10.4.0",
    "better-auth": "^1.6.20",
    "drizzle-orm": "^0.45.2",
    "luxon": "^3.7.2",
    "motion-v": "^2.3.0",
    "nuxt": "^4.4.8",
    "postgres": "^3.4.9",
    "rrule": "^2.8.1",
    "tailwindcss": "^4.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.16.0",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/test-utils": "^4.0.3",
    "@playwright/test": "^1.61.1",
    "@types/luxon": "^3.7.2",
    "@types/node": "^26.0.1",
    "auth": "^1.6.22",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.5.0",
    "happy-dom": "^20.10.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.5"
  },
  "packageManager": "pnpm@11.8.0"
}
