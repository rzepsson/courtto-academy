DATABASE_URL="postgres://user:password@localhost:5432/courtto"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# S3-compatible object storage for school logo uploads (Cloudflare R2 / AWS S3 /
# MinIO). Leave unset to disable uploads — the settings UI degrades gracefully.
S3_ENDPOINT=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET=""
# Public base URL objects are served from (R2 public bucket URL or a CDN), no
# trailing slash.
S3_PUBLIC_URL=""
# Set to "true" for MinIO (path-style addressing); leave unset for R2/S3.
S3_FORCE_PATH_STYLE=""

# Transactional email over SMTP (password reset + staff invitations). Provider is
# swappable by env alone — Brevo's SMTP relay in prod, AWS SES (eu-central-1) at
# scale, Mailpit in dev. Leave SMTP_HOST/MAIL_FROM unset to fall back to the loud
# console transport, which prints every mail (link included) to the server log so
# the flow is still completable locally — it never silently no-ops.
#   Dev with Mailpit: SMTP_HOST=localhost SMTP_PORT=1025 MAIL_FROM="Courtto <dev@courtto.local>"
#   (run: docker run -d -p 1025:1025 -p 8025:8025 axllent/mailpit — inbox on :8025)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
# "true" to connect over TLS immediately (port 465); leave unset for STARTTLS (587).
SMTP_SECURE=""
# The From header on every message, e.g. "Courtto Academy <no-reply@courtto.app>".
MAIL_FROM=""

# Observability (optional). Every server-side incident is always logged as a
# structured JSON line; when this is set, each event is ALSO POSTed as JSON
# (fire-and-forget) — point it at a log drain, a Slack incoming webhook, or a
# function that forwards to Sentry/Datadog. Unset -> structured console only (loud,
# never silent). Read lazily in server/utils/monitoring.ts.
OBSERVABILITY_WEBHOOK_URL=""

# SaaS subscription billing (Stripe). The school (organization) is the paying
# tenant. Leave unset in dev: every new school runs on a 14-day APP-managed trial
# (no card, no Stripe object), and the pricing UI degrades to a "billing not
# configured" notice — nothing breaks. Read lazily in server/utils/billing-config.ts.
#   STRIPE_SECRET_KEY      — Stripe secret API key (sk_live_… / sk_test_…)
#   STRIPE_WEBHOOK_SECRET  — signing secret for the webhook Stripe posts to
#                            /api/auth/stripe/webhook (whsec_…)
#   STRIPE_PRICE_STARTER   — Stripe Price id for the Starter plan (price_…)
#   STRIPE_PRICE_PRO       — Stripe Price id for the Pro plan (price_…)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""

# Lesson-fee collection (parents pay the school) — Stripe Connect. The school is
# the merchant; Courtto is the platform. Reuses STRIPE_SECRET_KEY above (one Stripe
# platform account). Leave unset in dev: the payments feature degrades to an
# "unavailable" notice, nothing breaks. Read lazily in server/utils/payments-config.ts.
#   STRIPE_CONNECT_WEBHOOK_SECRET — signing secret for the Connect webhook Stripe
#                                   posts to /api/webhooks/stripe-connect (whsec_…)
#   PLATFORM_FEE_PERCENT          — Courtto's commission on lesson fees, 0–100
#                                   (default 0 — the mechanism is wired, takes nothing)
STRIPE_CONNECT_WEBHOOK_SECRET=""
PLATFORM_FEE_PERCENT="0"
